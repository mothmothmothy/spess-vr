; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="vr-spess"
run/main_scene="uid://dlb2a33olyi8l"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Constraints="*uid://cxps8tv812f32"
TransformMath="*uid://cyw71big4jwfn"

[layer_names]

3d_physics/layer_1="other"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=100
jolt_physics_3d/simulation/position_steps=20
jolt_physics_3d/limits/max_angular_velocity=174532925199.4155
3d/default_gravity=0.0
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/compress_with_gpu=false
textures/vram_compression/cache_gpu_compressor=false
textures/lossless_compression/force_png=true
textures/webp_compression/compression_method=0

[xr]

openxr/enabled=true
shaders/enabled=true
